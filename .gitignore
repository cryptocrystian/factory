# Run records — the raw trace/audit, not source. Regenerable, can be large.
runs/
*.db
*.db-wal
*.db-shm

# Secrets — never committed. Injected per phase.
.env
.env.*

# Python / uv
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
.vscode/
.idea/

# Secrets — never commit key material (sovereign/agent keys, env creds)
*.key
*.nsec
ops/owner.key
ops/*.key
**/secrets/
*.env
.env
owner-import.txt
.env*

# The golden replay recording is versioned deliberately (gzipped, ~1.5MB): it is the input to
# verify.py's regression and is NOT regenerable, unlike everything else under runs/.
!control-plane/goldens/
